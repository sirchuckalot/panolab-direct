# Owner-provisioned values. Copy to docker/.env (ignored by Git).
# The same token must appear in docker/private/mcp-bearer as:
#   Bearer <PANOLAB_MCP_TOKEN>
PANOLAB_MCP_TOKEN=
PANOLAB_TUNNEL_ID=
# The tunnel key, license and installer archive live in docker/private/
# and must never be committed. Use chmod 0600 for tunnel-api-key/mcp-bearer.
