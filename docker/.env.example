# Owner-provisioned values. Copy to docker/.env (ignored by Git).
# The same token must appear in PANOLAB_CONFIG_DIR/mcp-bearer as:
#   Bearer <PANOLAB_MCP_TOKEN>
PANOLAB_MCP_TOKEN=
PANOLAB_TUNNEL_ID=
# The tunnel key and license live in PANOLAB_CONFIG_DIR. The archive lives in PANOLAB_DATA_DIR.
# and must never be committed. Use chmod 0600 for tunnel-api-key/mcp-bearer.
